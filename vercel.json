{
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/styles.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=14400, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/artigos/no-do-dia-oito-pecas.html",
      "destination": "/artigos/jogos-iba-tres-jogos-diarios.html",
      "permanent": true
    },
    {
      "source": "/artigos/conta-do-dia-qualquer-conta.html",
      "destination": "/artigos/jogos-iba-tres-jogos-diarios.html",
      "permanent": true
    },
    {
      "source": "/artigos/retangulo-do-dia-grade-sem-sobra.html",
      "destination": "/artigos/jogos-iba-tres-jogos-diarios.html",
      "permanent": true
    },
    {
      "source": "/artigos/como-nascem-os-jogos-diarios.html",
      "destination": "/artigos/jogos-iba-tres-jogos-diarios.html",
      "permanent": true
    }
  ]
}
